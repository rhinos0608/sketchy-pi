{
  "name": "@rhinos0608/sketchy-pi",
  "mcpName": "io.github.ddkbs/sketchy",
  "version": "0.2.0-pi.4",
  "description": "Sketchy drawing engine with one native Pi showcase tool and packaged agent skills; upstream MCP support retained for non-Pi clients.",
  "type": "module",
  "license": "MIT",
  "author": "ddkbs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhinos0608/sketchy-pi.git"
  },
  "homepage": "https://github.com/rhinos0608/sketchy-pi#readme",
  "bugs": {
    "url": "https://github.com/rhinos0608/sketchy-pi/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "native-extension",
    "showcase",
    "skills",
    "diagrams",
    "mcp-apps",
    "claude",
    "claude-code",
    "vscode",
    "cursor",
    "diagram",
    "visualization",
    "arduino",
    "svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:parts && npm run build:server && npm run build:viewer && npm run build:raster",
    "build:parts": "node scripts/extract-parts.mjs",
    "build:server": "tsc",
    "build:viewer": "tsc -p viewer/tsconfig.json && vite build && vite build --mode standalone",
    "build:raster": "vite build -c vite.raster.config.ts && node scripts/build-fonts.mjs",
    "build:skill": "node scripts/build-skill.mjs",
    "build:web": "vite build -c web/vite.config.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p viewer/tsconfig.json && tsc -p skill/tsconfig.json && tsc -p web/tsconfig.json && tsc -p claude-code/tsconfig.json && npm run typecheck:pi",
    "preview": "tsx scripts/preview-data.ts && vite",
    "screenshots": "tsx scripts/screenshots.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack": "node scripts/pack.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "pack:pi": "mkdir -p release && npm pack --pack-destination release && cd pi/skills && zip -qr ../../release/sketchy-pi-skills.zip .",
    "typecheck:pi": "npm run build:server && tsc -p pi/tsconfig.json"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/sql.js": "^1.4.11",
    "@types/topojson-client": "^3.1.5",
    "@wokwi/elements": "^1.9.2",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.15",
    "prettier": "^3.9.9",
    "roughjs": "^4.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.149",
    "@iconify-json/simple-icons": "^1.2.101",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "d3-geo": "^3.1.2",
    "elkjs": "^0.12.1",
    "sharp": "^0.35.5",
    "sql.js": "^1.15.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "bin": {
    "sketchy": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "build/parts.json",
    "build/viewer.html",
    "build/standalone.html",
    "build/raster.js",
    "build/fonts",
    "LICENSE",
    "README.md",
    "assets/icon.png",
    "THIRD_PARTY_NOTICES.md",
    "pi",
    "python",
    "README-PI.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./pi/extension.ts"
    ],
    "skills": [
      "./pi/skills"
    ]
  }
}
